{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING"
  },
  "JWT": {
    "key": "YOUR_JWT_KEY",
    "Issuer": "TourismApp",
    "Audience": "TourismAppUsers",
    "DurationInMinutes": 15
  },
  "EmailSettings": {
    "Email": "YOUR_EMAIL",
    "Password": "YOUR_EMAIL_PASSWORD"
  },
  "Geoapify": {
    "ApiKey": "YOUR_API_KEY"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8080"
      }
    }
  }
}